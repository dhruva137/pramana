# PRAMANA environment — paste secrets here for local runs.
# On the deployed console, judges can paste keys in Settings (sent per-request).
# Without keys the app runs in MOCK mode (deterministic sealer + fake Razorpay).

PRAMANA_ENV=demo
DATABASE_URL=sqlite+aiosqlite:///./pramana.db

# Generate with: python -m core.keys.generate
PRAMANA_SEAL_SK=
PRAMANA_PROOF_SK=
PRAMANA_SEAL_KID=seal-2026-09
PRAMANA_PROOF_KID=proof-2026-09

# Optional — leave empty for mock sealer (no LLM needed)
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Or Anthropic:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional — leave empty for mock payments. MUST start with rzp_test_ if set.
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret_for_demo

ALLOW_ORIGINS=*
MOCK_MODE=true
